# Copy to .env and fill in real values. Never commit .env —
# it is listed in .gitignore.
#
# These values are read by docker compose and passed to the
# backend container (see docker-compose.yml). The application
# refuses to start without JWT_SECRET and APP_CREDENTIAL_ENCRYPTION_KEY.

# JDBC URL of the MySQL database
DB_URL=jdbc:mysql://localhost:3306/velocity_management?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

# HS256 signing key for the JWTs (use a long random value, e.g. `openssl rand -base64 48`)
JWT_SECRET=

# AES-256-GCM passphrase used to store the initial collaborator
# passwords an administrator can display again (e.g. `openssl rand -base64 32`)
APP_CREDENTIAL_ENCRYPTION_KEY=
